====================The ir of tests/to1.sy =======================
define int process_values ( int, int, int ) {
entry
    Alloca $x int, align 4
    Alloca $y int, align 4
    Alloca $z int, align 4
    br BB1

BB1
    %T0 = Load $x
    %T1 = icmp lt %T0 10
    cond br %T1 BB2 BB3

BB2
    br BB4

BB3
    %T22 = Load $z
    ret %T22

BB4
    %T2 = Load $y
    %T3 = icmp lt %T2 5
    cond br %T3 BB5 BB7

BB5
    %T4 = Load $z
    %T5 = add %T4 1
    Store %T5 $z
    %T6 = Load $x
    %T7 = mul %T6 2
    Store %T7 $x

BB6
    %T20 = Load $x
    %T21 = add %T20 1
    Store %T21 $x
    br BB1

BB7
    br BB8

BB8
    %T8 = Load $z
    %T9 = icmp lt %T8 100
    cond br %T9 BB9 BB10

BB9
    Alloca $remainder int, align 4
    %T10 = Load $x
    %T11 = srem %T10 2
    Store %T11 $remainder
    br BB11

BB10

BB11
    %T12 = Load $remainder
    %T13 = icmp eq %T12 0
    cond br %T13 BB12 BB14

BB12
    %T14 = Load $y
    %T15 = add %T14 1
    Store %T15 $y

BB13
    %T18 = Load $z
    %T19 = mul %T18 3
    Store %T19 $z
    br BB8

BB14
    %T16 = Load $y
    %T17 = sub %T16 1
    Store %T17 $y

}
define int main (  ) {
entry
    Alloca $start_x int, align 4
    Store 1 $start_x
    Alloca $start_y int, align 4
    Store 2 $start_y
    Alloca $start_z int, align 4
    Store 3 $start_z
    Alloca $final_z int, align 4
    %T23 = Load $start_x
    %T24 = Load $start_y
    %T25 = Load $start_z
    %T26 = Call process_values( %T23, %T24, %T25 )
    Store %T26 $final_z
    ret 0

}
