int main() {
    int x = 1;
    int y = 2;
    int z = 3;
    while (x < 10) { 
        if (y < 5) { 
            z = z + 1;
            x = x * 2; 
        } else {

            while (z < 100) { 
                if (x % 2 == 0) { 
                    y = y + 1;
                } else { 
                    y = y - 1;
                }
                z = z * 3;
            }
        }
        x = x + 1; 
    }
    return z; 
}