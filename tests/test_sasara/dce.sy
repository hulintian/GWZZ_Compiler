int main() {
    int a = 10; // (存活)
    int b = 5;  // (存活)

    int live_val = a * 2;  // (存活) 因为最终被 return 使用了

    // === 死代码区域 1: 一个无用的计算链 ===
    int dead_x = 100;      // (死亡)
    int dead_y = dead_x / 2; // (死亡)
    int dead_z = dead_y - b; // (死亡)

    // === 死代码区域 2: 一个无用的PHI节点 ===
    int dead_phi_val;

    if (a > b) { // 使用 a 和 b
        // 分支内的死代码
        int dead_if_val = b + 5; // (死亡)

        dead_phi_val = 1; // (死亡)
    } else {
        live_val = live_val + b; // (存活) 修改了 live_val
        dead_phi_val = 2;         // (死亡)
    }
    
    // PHI节点：
    // 1. 一个 live_val 的PHI节点 (存活)
    // 2. 一个 dead_phi_val 的PHI节点 (死亡)

    return live_val; // (存活) "根"指令
}