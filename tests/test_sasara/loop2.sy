// test_advanced_flow.sy

int test_flow(int a, int b) {
    int result = 0;
    int i = 0;
    
    // 主循环
    while (i < 10) {
        
        if (a > 100) {
            // break语句，直接跳出while循环
            break; 
        }

        // continue语句，跳过本次循环的后续部分，直接开始下一次循环
        if (b == 0) {
            i = i + 1;
            continue; 
        }

        // 连续的if-else if-else结构
        if (a % 2 == 0) {
            result = result + a;
        } else if (b % 2 != 0) {
            result = result + b;
        } else {
            result = result + 1;
        }

        a = a - 5;
        b = b - 1;
        i = i + 1;
    }

    // 一个空的for循环，但有初始化、条件和更新
    // 用来测试CFG是否能正确处理这种退化的情况
    int j = 0;
    j = a;
    while (j < b) { 

        j = j + 1;
    }

    return result + j;
}

int main() {
    int res = test_flow(120, 5);
    return res;
}