    /* User Code Start: {{ cls.classname }} */

    /* User Code End: {{ cls.classname }} */
    {
        /* User Code Start: {{ cls.classname }} construct function */

        /* User Code End: {{ cls.classname }} construct function */
    }

    /* User Code Start: */

    /* User Code End: */

    {%- for method in cls.methods %}
    {{ method.type }} {{ method.name }}({{ method.args }}){{ " const" if method.is_const }};
    {%- endfor %}

    {% for member in cls.members %} {% if member.generate_get %}
    {{ member.type }} get{{ member.name }}() const {
        /* User Code Start: {{ cls.classname }}::get_{{ member.name[1:] }} */
        return {{ member.name }};
        /* User Code End: {{ cls.classname }}::get_{{ member.name[1:] }} */
